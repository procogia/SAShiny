# SAShiny audit server image (Igor's two-VM audit, containerized).
#
# Builds a container with R, Python, Java 17, saspy, the SAShiny R package and
# Python wheel, and the audit harness. It serves the synthetic operation API
# (port 8000) plus the observable Shiny apps (8001-8003). No live SAS: the
# audit uses the mock/fake engine only (SASHINY_LIVE=0).
#
# Build from the repository root (the build context must include the repo):
#   docker build -f deploy/audit/Dockerfile.server -t sashiny-audit-server .

# --- R + Python + Java base -------------------------------------------------
FROM rocker/r-ver:4.4.3 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    MPLBACKEND=Agg \
    SASHINY_LIVE=0 \
    NOT_CRAN=true \
    R_LIBS_USER=/tmp/Rlib

# Java 17 (for SAS 9.4 IOM connections via saspy) + R system deps + pandoc.
RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        build-essential \
        python3-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        python3 \
        python3-pip \
        python3-venv \
        curl \
        ca-certificates \
        pandoc \
    && rm -rf /var/lib/apt/lists/*

# uv (Python package manager).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# --- Repository checkout ----------------------------------------------------
# The harness hard-codes /tmp/SAShiny (repo) and /tmp/audit (harness), matching
# the original Daytona layout, so the scripts run unchanged.
WORKDIR /tmp/SAShiny
COPY . /tmp/SAShiny
COPY deploy/audit /tmp/audit

# --- Python library + audit extras -----------------------------------------
RUN cd /tmp/SAShiny/Python \
 && uv sync --all-extras \
 && uv pip install --python .venv/bin/python fastapi uvicorn httpx coverage build hatchling \
 && .venv/bin/python -m build --outdir /tmp/audit/dist \
 && uv pip install --python .venv/bin/python --reinstall --no-deps /tmp/audit/dist/sashiny-*.whl

# --- R package + dependencies ----------------------------------------------
# Install the R package and its dependencies. reticulate then comes from
# current CRAN (the base image's snapshot is too old for pandas 3).
RUN Rscript -e 'install.packages(c("remotes"), repos="https://cloud.r-project.org")' \
 && Rscript -e 'remotes::install_local("/tmp/SAShiny/R", dependencies=TRUE, upgrade="never")' \
 && Rscript -e 'install.packages("reticulate", repos="https://cloud.r-project.org"); stopifnot(packageVersion("reticulate") >= "1.45.0")'

# --- Runtime ----------------------------------------------------------------
WORKDIR /tmp/audit
EXPOSE 8000 8001 8002 8003

# Start the API + Shiny apps (start_server.py records PIDs for cleanup).
CMD ["sh", "-c", "/tmp/SAShiny/Python/.venv/bin/python start_server.py && sleep infinity"]