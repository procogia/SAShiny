{
  "name": "SAShiny",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "reditorsupport.r",
        "mechatroner.rainbow-csv"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/app/Python/.venv/bin/python",
        "r.rterm.linux": "/usr/local/bin/R"
      }
    }
  },
  "forwardPorts": [8000],
  "remoteEnv": {
    "SASHINY_CONNECTIONS": "/app/examples/connections.example.yml",
    "SASHINY_PROFILE": "offline"
  },
  "mounts": [
    "source=${localEnv:HOME}/.authinfo,target=/root/.authinfo,type=bind,readonly"
  ],
  "postCreateCommand": "cd Python && uv sync --extra shiny --extra saspy"
}