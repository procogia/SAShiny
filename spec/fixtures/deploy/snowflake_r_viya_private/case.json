      "spcs/service.sql",
      "spcs/setup.sql"
    ],
    "excluded": [],
    "env": [["SASHINY_LICENSE_ACK", "true"], ["SASHINY_PROFILE", "viya"], ["SASHINY_VIYA_URL", "https://viya.example.com"]],
    "secrets": ["SASHINY_SAS_USER", "SASHINY_SAS_PASSWORD"],
    "endpoints": ["viya.example.com:443"]
