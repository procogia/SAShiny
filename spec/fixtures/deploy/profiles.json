{
  "description": "Connection profiles for deployment targets (CONTRACT.md 6.8): kind, egress endpoints, Java, runtime environment and validation errors. Written by hand from the spec.",
  "cases": [
    {
      "name": "oda_us1",
      "profile": {"name": "oda", "method": "iom", "oda_region": "us1", "iomport": 8591, "authkey": "oda", "label": "SAS OnDemand for Academics"},
      "expected": {
        "kind": "oda",
        "endpoints": ["odaws01-usw2.oda.sas.com:8591", "odaws01-usw2.oda.sas.com:8800-8999", "odaws02-usw2.oda.sas.com:8591", "odaws02-usw2.oda.sas.com:8800-8999"],
        "needs_java": true,
        "requires_vpn": false,
        "env": [["SASHINY_LICENSE_ACK", "true"], ["SASHINY_PROFILE", "oda"], ["SASHINY_ODA_REGION", "us1"]],
        "secrets": ["SASHINY_SAS_USER", "SASHINY_SAS_PASSWORD"]
      }
    },
