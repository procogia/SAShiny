{
  "description": "container target, R app on a Viya (HTTP) profile, custom port: no Java.",
  "add_files": {},
  "target": "container",
  "version": "0.0.0",
  "license_ack": true,
  "options": {"port": 3838},
  "profile": {"name": "viya", "method": "http", "url": "https://viya.example.com"},
  "expected": {
    "language": "r",
    "files": [
      ".dockerignore",
      "Dockerfile",
      "bundle/app.R",
      "bundle/report.sas",
      "bundle/report.sashiny.yml"
    ],
    "excluded": [],
    "env": [["SASHINY_LICENSE_ACK", "true"], ["SASHINY_PROFILE", "viya"], ["SASHINY_VIYA_URL", "https://viya.example.com"]],
    "secrets": ["SASHINY_SAS_USER", "SASHINY_SAS_PASSWORD"],
    "endpoints": ["viya.example.com:443"]
  }
}
