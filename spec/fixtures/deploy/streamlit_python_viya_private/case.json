{
  "description": "streamlit_snowflake, Python app on a VPN-only Viya profile: private_connectivity gives PRIVATE_HOST_PORT rules; custom names and title.",
  "add_files": {},
  "target": "streamlit_snowflake",
  "version": "0.0.0",
  "license_ack": true,
  "options": {
    "app_name": "CARS_APP",
    "database": "ANALYTICS",
    "schema": "SAS",
    "compute_pool": "STREAMLIT_POOL",
    "warehouse": "REPORTING_WH",
    "title": "Car price explorer",
    "private_connectivity": true
  },
  "profile": {"name": "procogia_viya", "method": "http", "url": "https://viya.example.com", "requires_vpn": true},
  "expected": {
    "language": "python",
    "files": [
      "bundle/app.py",
      "bundle/cars.sas",
      "bundle/cars.sashiny.yml",
      "bundle/data/cars.csv",
      "bundle/pyproject.toml",
      "bundle/streamlit_app.py",
      "deploy-streamlit-snowflake.md",
      "snowflake/secret.sql",
      "snowflake/setup.sql",
      "snowflake/streamlit.sql"
    ],
    "excluded": [],
    "env": [["SASHINY_LICENSE_ACK", "true"], ["SASHINY_PROFILE", "viya"], ["SASHINY_VIYA_URL", "https://viya.example.com"]],
    "secrets": ["SASHINY_SAS_USER", "SASHINY_SAS_PASSWORD"],
    "endpoints": ["viya.example.com:443"]
  }
}
