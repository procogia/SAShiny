{
  "description": "databricks_apps, Python app on Viya: app.yaml with DATABRICKS_APP_PORT and secret resources via valueFrom, pinned requirements, apps create JSON.",
  "add_files": {".authinfo": "placeholder credential file\n"},
  "target": "databricks_apps",
