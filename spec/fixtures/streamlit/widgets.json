{
  "description": "Streamlit widget mapping (CONTRACT.md 6.9): one case per input type and widget variant of spec/sashiny.schema.json. 'today' is 2026-11-11. 'kwargs' are the widget's keyword arguments other than label and key; dates are ISO strings.",
  "today": "2026-11-11",
  "cases": [
    {"name": "numeric", "input": {"type": "numeric", "label": "Price", "min": 0, "max": 10.5, "step": 0.5, "default": 2.5, "help": "Minimum price"},
     "expected": {"widget": "number_input", "kwargs": {"help": "Minimum price", "value": 2.5, "min_value": 0.0, "max_value": 10.5, "step": 0.5}}},
    {"name": "numeric_integer", "input": {"type": "numeric", "label": "Year", "min": 2000, "max": 2030, "integer": true, "default": 2020},
     "expected": {"widget": "number_input", "kwargs": {"value": 2020, "min_value": 2000, "max_value": 2030, "step": 1, "format": "%d"}}},
    {"name": "numeric_empty", "input": {"type": "numeric", "label": "Limit", "optional": true},
     "expected": {"widget": "number_input", "kwargs": {"value": null}}},
    {"name": "text", "input": {"type": "text", "label": "Name", "max_length": 40, "placeholder": "e.g. Smith", "default": "Ann"},
     "expected": {"widget": "text_input", "kwargs": {"value": "Ann", "max_chars": 40, "placeholder": "e.g. Smith"}}},
    {"name": "text_defaults", "input": {"type": "text", "label": "Name"},
     "expected": {"widget": "text_input", "kwargs": {"value": "", "max_chars": 256}}},
    {"name": "choice_select", "input": {"type": "choice", "label": "Origin", "choices": ["Asia", {"value": "EU", "label": "Europe"}], "default": "EU"},
     "expected": {"widget": "selectbox", "kwargs": {"index": 1}, "options": ["Asia", "EU"], "labels": {"Asia": "Asia", "EU": "Europe"}}},
    {"name": "choice_radio", "input": {"type": "choice", "label": "Origin", "choices": ["Asia", "USA"], "widget": "radio"},
     "expected": {"widget": "radio", "kwargs": {"index": null}, "options": ["Asia", "USA"], "labels": {"Asia": "Asia", "USA": "USA"}}},
    {"name": "choice_from", "input": {"type": "choice", "label": "Make", "choices_from": {"dataset": "sashelp.cars", "value_column": "make"}},
     "loaded": [{"value": "Acura", "label": "Acura"}, {"value": "BMW", "label": "BMW"}],
     "expected": {"widget": "selectbox", "kwargs": {"index": null}, "options": ["Acura", "BMW"], "labels": {"Acura": "Acura", "BMW": "BMW"}}},
    {"name": "multichoice_select", "input": {"type": "multichoice", "label": "Types", "choices": ["Sedan", "SUV", "Truck"], "default": ["SUV"], "max_selected": 2},
     "expected": {"widget": "multiselect", "kwargs": {"default": ["SUV"], "max_selections": 2}, "options": ["Sedan", "SUV", "Truck"], "labels": {"Sedan": "Sedan", "SUV": "SUV", "Truck": "Truck"}}},
    {"name": "multichoice_checkbox", "input": {"type": "multichoice", "label": "Origin", "choices": ["Asia", "Europe"], "default": ["Asia", "Europe"], "widget": "checkbox"},
     "expected": {"widget": "checkbox_group", "kwargs": {"default": ["Asia", "Europe"]}, "options": ["Asia", "Europe"], "labels": {"Asia": "Asia", "Europe": "Europe"}}},
    {"name": "date", "input": {"type": "date", "label": "As of", "min": "2026-01-01", "max": "today", "default": "today"},
     "expected": {"widget": "date_input", "kwargs": {"value": "2026-11-11", "min_value": "2026-01-01", "max_value": "2026-11-11"}}},
    {"name": "daterange", "input": {"type": "daterange", "label": "Period", "default": ["2026-01-01", "today"]},
     "expected": {"widget": "date_range_input", "kwargs": {"value": ["2026-01-01", "2026-11-11"], "min_value": null, "max_value": null}}},
    {"name": "daterange_empty", "input": {"type": "daterange", "label": "Period", "optional": true},
     "expected": {"widget": "date_range_input", "kwargs": {"value": [], "min_value": null, "max_value": null}}},
    {"name": "dataset", "input": {"type": "dataset", "label": "Data", "target": "work.upload", "accept": ["csv", "xlsx"]},
     "expected": {"widget": "file_uploader", "kwargs": {"type": ["csv", "xlsx"]}}},
    {"name": "dataset_sample", "input": {"type": "dataset", "label": "Data", "target": "work.upload", "sample": "sample.csv"},
     "expected": {"widget": "file_uploader", "kwargs": {"type": ["csv", "xlsx", "xpt", "sas7bdat"], "sample": true}}}
  ]
}